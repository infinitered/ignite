{
  "name": "expo-app-starter",
  "version": "0.1.0",
  "private": true,
  "main": "index.tsx",
  "description": "FAANG-quality, SaaS-ready, context-engineered Expo + React Native starter template.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "bundle:web": "npx expo export --platform web",
    "serve:web": "npx serve dist",
    "prebuild:clean": "npx expo prebuild --clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p . --pretty",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test .maestro/flows",
    "test:maestro": "maestro test -e MAESTRO_APP_ID=com.example.app .maestro/flows",
    "gen": "tsx scripts/generate.ts",
    "rename": "tsx scripts/rename.ts",
    "clean-demo": "tsx scripts/clean-demo.ts",
    "setup": "bash scripts/bootstrap.sh",
    "before-pr": "pnpm lint && pnpm typecheck && pnpm test",
    "bundle:analyze": "tsx scripts/analyze-bundle.ts",
    "bundle:check": "tsx scripts/check-bundle-size.ts",
    "doctor": "expo-doctor",
    "depcruise": "depcruise app --config .dependency-cruiser.js",
    "align-deps": "npx expo install --fix",
    "prepare": "husky",
    "build:ios:sim": "eas build --profile development --platform ios --local",
    "build:ios:device": "eas build --profile development:device --platform ios --local",
    "build:ios:preview": "eas build --profile preview --platform ios --local",
    "build:ios:prod": "eas build --profile production --platform ios --local",
    "build:android:sim": "eas build --profile development --platform android --local",
    "build:android:device": "eas build --profile development:device --platform android --local",
    "build:android:preview": "eas build --profile preview --platform android --local",
    "build:android:prod": "eas build --profile production --platform android --local",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.0",
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^14.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@sentry/react-native": "^6.5.0",
    "@shopify/flash-list": "1.7.6",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "55.0.5",
    "expo-application": "~55.0.8",
    "expo-blur": "~15.0.7",
    "expo-build-properties": "~55.0.9",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~55.0.11",
    "expo-device": "~8.0.7",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~55.0.4",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.5",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-notifications": "~0.32.7",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~3.0.7",
    "expo-system-ui": "~55.0.9",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "~15.0.10",
    "i18next": "^23.14.0",
    "intl-pluralrules": "^2.0.1",
    "lottie-react-native": "7.2.4",
    "nativewind": "^4.1.23",
    "posthog-react-native": "^3.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.0.1",
    "react-native": "0.83.2",
    "react-native-css-interop": "^0.1.22",
    "react-native-drawer-layout": "^4.0.1",
    "react-native-edge-to-edge": "~1.6.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "3.3.3",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "setimmediate": "^1.0.5",
    "tailwind-merge": "^2.5.5",
    "tailwind-variants": "^0.3.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.2.1",
    "dependency-cruiser": "^17.0.2",
    "expo-doctor": "^1.12.5",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.9",
    "lint-staged": "^15.2.11",
    "msw": "^2.7.0",
    "react-test-renderer": "19.2.0",
    "reactotron-core-client": "^2.9.4",
    "reactotron-react-native": "^5.0.5",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2"
  }
}
