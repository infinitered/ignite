# =============================================================================
# Environment template. Copy to .env.local and fill in.
# Validated by app/config/env.ts at boot — bad values = app crash with Zod error.
# =============================================================================

# --- Public (bundled into the JS, visible to clients) ---------------------
# Backend API base URL.
EXPO_PUBLIC_API_URL=https://jsonplaceholder.typicode.com

# Environment name. One of: development | staging | production
EXPO_PUBLIC_ENV=development

# PostHog (analytics + feature flags). Leave empty to disable.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# EAS project ID (for push tokens).
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Build-time only (NOT bundled into JS, used by EAS / CI) --------------
# Sentry DSN for runtime error reporting. Public-ish but kept off-bundle.
SENTRY_DSN=

# Sentry source-map upload (CI / EAS).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
